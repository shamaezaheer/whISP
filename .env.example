# ============================================================
# whISP Platform - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Core ---
PLATFORM_NAME=whISP
PLATFORM_DOMAIN=yourdomain.com.bd
ENVIRONMENT=development
ADMIN_EMAIL=admin@yourdomain.com.bd
ADMIN_PASSWORD=change-me-in-production

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://isp_user:isp_password@localhost:5432/isp_platform
RADIUS_DB_URL=postgresql+asyncpg://isp_user:isp_password@localhost:5432/isp_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- JWT (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=change-this-to-a-64-char-random-string-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=30

# --- Encryption (generate with: openssl rand -hex 16) ---
ENCRYPTION_KEY=change-this-32-char-encryption-key!!

# --- bKash ---
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://yourdomain.com.bd/payments/bkash/callback

# --- Nagad ---
NAGAD_BASE_URL=https://sandbox.nagad.com.bd
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PHONE=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_CALLBACK_URL=https://yourdomain.com.bd/payments/nagad/callback

# --- SSLCommerz ---
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SUCCESS_URL=https://yourdomain.com.bd/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=https://yourdomain.com.bd/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=https://yourdomain.com.bd/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=https://yourdomain.com.bd/payments/sslcommerz/ipn

# --- SMS Gateway (SSL Wireless) ---
SMS_GATEWAY_URL=http://sms.sslwireless.com/pushapi/dynamic/server.php
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=whISP

# --- FCM Push Notifications ---
FCM_SERVER_KEY=

# --- OTT Partners ---
CHORKI_BASE_URL=https://api.chorki.com
CHORKI_API_KEY=
CHORKI_PARTNER_ID=
CHORKI_PARTNER_SECRET=
HOICHOI_BASE_URL=https://api.hoichoi.tv
HOICHOI_API_KEY=
HOICHOI_PARTNER_ID=
HOICHOI_PARTNER_SECRET=

# --- FreeRADIUS ---
RADIUS_COA_DEFAULT_PORT=3799
RADIUS_COA_TIMEOUT=5.0
